{
  "id": "anikoto",
  "name": "Anikoto",
  "version": "1.3.17",
  "manifestURI": "https://raw.githubusercontent.com/fampep/extensions/main/seanime/anikoto/manifest.json",
  "language": "typescript",
  "type": "onlinestream-provider",
  "description": "Only anikoto compatibility layer you'll ever need",
  "author": "fampep",
  "icon": "https://raw.githubusercontent.com/fampep/extensions/main/seanime/anikoto/icon.png",
  "website": "https://anikototv.to",
  "lang": "en",
  "payloadURI": "https://raw.githubusercontent.com/fampep/extensions/main/seanime/anikoto/provider.ts",
  "userConfig": {
    "version": 2,
    "requiresConfig": false,
    "fields": [
      {
        "type": "select",
        "name": "baseUrl",
        "label": "Site / mirror domain",
        "default": "https://anikototv.to",
        "options": [
          { "value": "https://anikototv.to", "label": "anikototv.to" },
          { "value": "https://anikoto.cz", "label": "anikoto.cz" },
          { "value": "https://anikoto.me", "label": "anikoto.me" },
          { "value": "https://anikoto.net", "label": "anikoto.net" },
          { "value": "https://anikototv.se", "label": "anikototv.se" }
        ]
      },
      {
        "type": "select",
        "name": "preferred_quality",
        "label": "Preferred Quality",
        "default": "Auto",
        "options": [
          { "value": "Auto", "label": "Auto (Adaptive)" },
          { "value": "1080p", "label": "1080p" },
          { "value": "720p", "label": "720p" },
          { "value": "480p", "label": "480p" },
          { "value": "360p", "label": "360p" }
        ]
      }
    ]
  }
}