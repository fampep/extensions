{
  "id": "anidb",
  "name": "AniDB",
  "version": "1.0.0",
  "manifestURI": "https://raw.githubusercontent.com/fampep/extensions/main/seanime/anidb/manifest.json",
  "language": "typescript",
  "type": "onlinestream-provider",
  "description": "AniDB (anidb.app) HLS streams — session cookie jar, Japanese / English tracks",
  "author": "fampep",
  "icon": "https://raw.githubusercontent.com/fampep/extensions/main/seanime/anidb/icon.png",
  "website": "https://anidb.app",
  "lang": "en",
  "payloadURI": "https://raw.githubusercontent.com/fampep/extensions/main/seanime/anidb/provider.ts",
  "userConfig": {
    "version": 1,
    "requiresConfig": false,
    "fields": [
      {
        "type": "select",
        "name": "baseUrl",
        "label": "Site domain",
        "default": "https://anidb.app",
        "options": [
          { "value": "https://anidb.app", "label": "anidb.app" },
          { "value": "https://www.anidb.app", "label": "www.anidb.app" }
        ]
      },
      {
        "type": "select",
        "name": "preferred_quality",
        "label": "Preferred Quality",
        "default": "Auto",
        "options": [
          { "value": "Auto", "label": "Auto (Adaptive)" },
          { "value": "1080p", "label": "1080p" },
          { "value": "720p", "label": "720p" },
          { "value": "480p", "label": "480p" },
          { "value": "360p", "label": "360p" }
        ]
      }
    ]
  }
}
